@thesis{Esseldeurs2022,
 language = {eng},
 publisher = {KU Leuven. Faculteit Wetenschappen. Master thesis},
 title = {SPH Approach to Modelling Dust Attenuation of the Wind Acceleration in AGB Binaries},
 year = {2022},
 author = {Esseldeurs, Mats},
 address = {Leuven},
 link = {https://lib.is/lbsn9993307989101471/representation?libis=11:1:1&lang=en},
 abstract={Circumstellar envelopes of asymptotic giant branch (AGB) stars have for a long time been modelled assuming a spherical symmetry. However, recent observations of the inner winds of these stars have shown that they exhibit a variety of complex structures, such as spirals, equatorial density enhancements, disks, bipolar outflows, etc. These structures are believed to originate from the presence of a companion, either stellar and/or planetary. Due to the inherently three-dimensional (3D) nature of this phenomenon, its investigation requires advanced 3D-simulations. It has already been shown that using hydrodynamic simulations, some of these wind morphologies can be obtained. However, the computational cost of truly selfconsistent calculations, including the crucial chemical and radiation processes, is currently still computationally prohibitive. Therefore, incremental modelling improvements using ever more refined approximations can significantly advance the quality and physical consistency of the simulations. One such problem revolves around the transfer of momentum from the stellar photons to the dust particles in the AGB wind. Until recently, this coupling has always either been ignored, or treated in the optically thin limit, which only requires knowledge on the local quantities. However, properly accounting for the dust opacity and its attenuation of the stellar radiation field can drastically affect the effective radiation pressure on the dust. In turn, this can significantly alter the dynamics and morphology of these stellar winds.

In the context of a large collaboration that revolves around upgrading the treatment of dusty winds within the smoothed-particle-hydrodynamics code PHANTOM, I have worked on levelling up the way in which dust acceleration is calculated. To calculate the attenuation of the stellar radiation field, knowledge on the distribution and optical properties of the matter in-between each particle and the star is required. To this end the ray-tracing algorithm of the radiative transfer code MAGRITTE was extracted, made compatible with the SPH philosophy, and coupled to PHANTOM. We investigated different options to speed up the ray-tracer with only a minimal loss in accuracy. We show that the best results are found when rays are traced outwards from the star in a uniform distribution, set by HEALPix. Because not all particles are struck by a ray, we also investigated different interpolation approaches. We find that interpolation scaling with the inverse square of the perpendicular distance to the four closest rays gives the most desirable result. Finally, we demonstrate the validity of our new approach in a simulation.}
}

@thesis{Esseldeurs2022d,
 language = {eng},
 publisher = {KU Leuven. Faculteit Wetenschappen. PhD thesis},
 title = {The orbital evolution of AGB binary systems},
 year = {2026},
 author = {Esseldeurs, Mats},
 address = {Leuven},
 link = {https://lirias.kuleuven.be/4418979?&lang=en},
 abstract={Binary and multiple stellar systems hosting evolved stars provide unique laboratories for studying the coupled evolution of stellar structure, mass loss, tidal interactions, and orbital dynamics. During the Asymptotic Giant Branch (AGB) phase, stars undergo intense pulsation-enhanced, dust-driven winds that expel a substantial fraction of their envelope. This mass loss not only governs the late evolution of the star itself, but also reshapes the orbital configuration of surrounding companions and sculpts the circumstellar environment into spirals, disks, and bipolar outflows. At the same time, tidal interactions act to dissipate energy and transfer angular momentum, often counteracting wind-driven orbital expansion. Predicting the fate of such systems therefore requires a unified treatment of waves, winds, and tides across a wide range of spatial and temporal scales. Prior to this work, the interplay between these processes has been modelled using prescriptions that lacked physical ab-initio modelling and used simplified prescriptions that often neglect key physical ingredients. In this thesis, I investigate the competition and interplay between mass-loss processes and tidal dissipation in evolved binary systems through a multi-method approach that combines analytical theory, stellar evolution modelling, and three-dimensional hydrodynamical simulations.
In order to couple the full physics of the pulsation enhanced dust-driven winds with the orbital dynamics, I first developed a new ray-tracing scheme to compute the radiative acceleration on dust grains in the outflow. This method accounts for the complex geometry of the circumstellar environment and the anisotropic radiation field, enabling self-consistent calculations of wind acceleration in binary systems.
Furthermore, I performed stellar evolution calculations to characterize the internal structure and convective properties of evolved stars. Using these models, I carried out a full parameter study of tidal dissipation in both the convective and radiative regions of stars, throughout their entire evolution, to determine the efficiency of the different tidal mechanisms, namely the equilibrium tide and tidally-excited progressive internal gravity waves, as a function of stellar mass, age, and the orbital configuration of the system.
I integrated these components into an orbital evolution framework that tracks the evolution of both the semi-major axis and eccentricity of binaries hosting evolved stars. This framework incorporates the effects of tidal dissipation and mass loss, allowing for predictions of the long-term orbital evolution. I applied  this framework to a range of observed systems, to the newly confirmed close binary system of π1 Gru, as well as to the future evolution of our Earth-Sun system.
The combined framework developed in this thesis therefore provides a coherent picture of how mass loss, tides, and convection jointly determine the orbital evolution and observable signatures of evolved binaries. The results place new constraints on tidal prescriptions used in binary population synthesis, refine predictions for common-envelope progenitors, and aid the interpretation of resolved circumstellar structures. More broadly, this work advances our understanding of how binary interaction channels shape the late stages of stellar evolution and the diversity of their astrophysical outcomes, including those of planetary systems.
}
}